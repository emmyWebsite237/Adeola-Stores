# Adeola Stores - Environment Configuration Template
# Copy this file to .env.local for local development

# ==========================================
# 1. SUPABASE (Database & Authentication)
# ==========================================
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ==========================================
# 2. PAYSTACK (Nigerian Payment Gateway)
# ==========================================
# Get these from: Paystack Dashboard -> Settings -> API Keys & Webhooks
# Use "pk_test_..." and "sk_test_..." for testing.
# Switch to "pk_live_..." and "sk_live_..." once your Starter Business is activated.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_sample_key_here
PAYSTACK_SECRET_KEY=sk_test_sample_key_here

# ==========================================
# 3. BREVO (Email Newsletter & Marketing)
# ==========================================
# Get this from: Brevo Dashboard (formerly Sendinblue) -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# ==========================================
# 4. FORMSUBMIT (Suggestions & Delivery Contact Desk)
# ==========================================
# FormSubmit works automatically without an API key!
# Submissions post directly to support@ladydeestores.com
# Configure your destination email directly in app/contact/page.tsx

# ==========================================
# 6. STORE IDENTITY & CONTACTS
# ==========================================
NEXT_PUBLIC_STORE_NAME="Lady Dee Adeola Stores"
NEXT_PUBLIC_STORE_PHONE="+2348023456789"
NEXT_PUBLIC_STORE_WHATSAPP="+2348023456789"
NEXT_PUBLIC_STORE_ADDRESS="Shop 14, Trade Fair Complex / Mainland Hub, Lagos"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
